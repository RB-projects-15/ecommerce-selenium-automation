<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Ecommerce Automation Suite">
    <test name="Login Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="com.qa.automation.tests.LoginTest"/>
            <class name="com.qa.automation.tests.ProductsTest"/>
            <class name="com.qa.automation.tests.ProductSortingTest"/>
            <class name="com.qa.automation.tests.CartTest"/>
        </classes>
    </test>
</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="E-Commerce Selenium Test Suite">

    <listeners>
        <listener class-name="com.qa.automation.utils.TestListener"/>
    </listeners>

    <test name="E-Commerce Regression Tests">
        <classes>
            <class name="com.qa.automation.tests.LoginTest"/>
            <class name="com.qa.automation.tests.ProductsTest"/>
            <class name="com.qa.automation.tests.ProductSortingTest"/>
            <class name="com.qa.automation.tests.CartTest"/>
            <class name="com.qa.automation.tests.CartRemoveTest"/>
            <class name="com.qa.automation.tests.CartContentTest"/>
            <class name="com.qa.automation.tests.CheckoutValidationTest"/>
            <class name="com.qa.automation.tests.EndToEndPurchaseTest"/>
        </classes>
    </test>

</suite>
